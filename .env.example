# =============================================================================
# AFFILIATE TRACKING SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env for local development
# For production deployment, use `wrangler secret put` commands

# =============================================================================
# PX API CONFIGURATION
# =============================================================================
# PX Direct Post API Tokens (Get from PX account manager)
PX_API_TOKEN_HEALTH=F9F9B3CC-85D8-4142-9007-61F784C1F098
PX_API_TOKEN_SOLAR=B593425D-90C7-4CB8-8952-605D8A0CCEC0
PX_API_TOKEN_HOME=

# PX API Endpoints
PX_DIRECT_POST_URL=https://leadapi.px.com/api/lead/directpost
PX_PING_POST_URL=https://leadapi.px.com/api/lead/pingpost

# =============================================================================
# MARKETCALL API CONFIGURATION  
# =============================================================================
# MarketCall API credentials (Get from MarketCall dashboard)
MARKETCALL_API_KEY=your_marketcall_api_key_here
MARKETCALL_API_SECRET=your_marketcall_secret_here
MARKETCALL_BASE_URL=https://api.marketcall.com/v1

# =============================================================================
# RINGBA CALL TRACKING CONFIGURATION
# =============================================================================
# Ringba webhook configuration for inbound call tracking
RINGBA_API_KEY=your_ringba_api_key_here
RINGBA_WEBHOOK_SECRET=your_webhook_secret_for_verification
RINGBA_BASE_URL=https://api.ringba.com/v2

# Ringba webhook endpoint (auto-configured)
# Format: https://your-domain.com/api/webhooks/ringba
RINGBA_WEBHOOK_URL=

# =============================================================================
# OPTIZMO CONFIGURATION
# =============================================================================
# Optizmo integration settings
OPTIZMO_API_KEY=your_optizmo_api_key_here
OPTIZMO_PUBLISHER_ID=your_publisher_id_here
OPTIZMO_BASE_URL=https://api.optizmo.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Cloudflare D1 Database (auto-configured in production)
# Local development uses SQLite with --local flag
DATABASE_URL=

# For local development with external database (optional)
LOCAL_DATABASE_URL=sqlite:///home/user/webapp/.wrangler/state/v3/d1/DB.sqlite3

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application settings
APP_NAME=Affiliate Tracker
APP_VERSION=1.0.0
APP_ENV=development

# Base URL for tracking links (auto-detected in production)
BASE_URL=http://localhost:3000
TRACKING_DOMAIN=your-tracking-domain.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here

# API Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=3600

# CORS settings
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# Email service for notifications (optional)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# ANALYTICS CONFIGURATION (Optional)
# =============================================================================
# Google Analytics tracking (optional)
GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog analytics (optional)
POSTHOG_API_KEY=your_posthog_key
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Additional integration APIs
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_hook_id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# =============================================================================
# CLOUDFLARE SPECIFIC CONFIGURATION
# =============================================================================
# Cloudflare Account Settings (for wrangler CLI)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_zone_id_for_custom_domain

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Debug settings for development
DEBUG=true
LOG_LEVEL=info
PRETTY_LOGS=true

# Local development ports
DEV_PORT=3000
VITE_DEV_PORT=5173

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test environment settings
TEST_DATABASE_URL=sqlite:///:memory:
TEST_PX_API_TOKEN=test_token_for_development
TEST_WEBHOOK_SECRET=test_webhook_secret

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Fill in required API keys and tokens
# 3. Run: npm run dev
#
# PRODUCTION DEPLOYMENT (Cloudflare Pages):
# 1. Use wrangler secret put commands:
#    wrangler secret put PX_API_TOKEN_HEALTH
#    wrangler secret put PX_API_TOKEN_SOLAR
#    wrangler secret put MARKETCALL_API_KEY
#    wrangler secret put RINGBA_API_KEY
#    etc.
# 2. Configure D1 database in wrangler.jsonc
# 3. Deploy: npm run deploy
#
# REQUIRED FOR BASIC OPERATION:
# - PX_API_TOKEN_SOLAR (for Solar leads)
# - PX_API_TOKEN_HEALTH (for Health leads)
# - Database configuration (D1 or local SQLite)
#
# OPTIONAL BUT RECOMMENDED:
# - RINGBA_API_KEY (for call tracking)
# - MARKETCALL_API_KEY (for additional lead routing)
# - JWT_SECRET (for API security)
#